# =============================================================================
# Django Settings
# =============================================================================

# Secret Key - IMPORTANT: Change this in production!
# Generate a new secret key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug Mode - Set to False in production
DEBUG=True

# Allowed Hosts - Add your domain names in production
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# =============================================================================
# AI Provider Configuration
# =============================================================================

# Select your AI provider (options: gemini, openai, claude, perplexity, grok, nvidia, groq)
# Default: nvidia
AI_PROVIDER=nvidia

# =============================================================================
# AI Provider API Keys
# =============================================================================
# You only need to set the API key for the provider you're using.
# However, you can configure multiple providers to switch between them easily.

# -----------------------------------------------------------------------------
# Google Gemini (default provider)
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
# Required package: google-genai (included in base dependencies)
# Model used: gemini-2.0-flash-exp
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# OpenAI GPT
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Required package: openai (install with: pip install openai)
# Model used: gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# Anthropic Claude
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
# Required package: anthropic (install with: pip install anthropic)
# Model used: claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Perplexity AI
# -----------------------------------------------------------------------------
# Get your API key from: https://www.perplexity.ai/settings/api
# Required package: openai (install with: pip install openai)
# Model used: llama-3.1-sonar-small-128k-online
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# -----------------------------------------------------------------------------
# xAI Grok
# -----------------------------------------------------------------------------
# Get your API key from: https://console.x.ai/
# Required package: openai (install with: pip install openai)
# Model used: grok-beta
XAI_API_KEY=your-xai-api-key-here

# -----------------------------------------------------------------------------
# NVIDIA NIM (default provider)
# -----------------------------------------------------------------------------
# Get your API key from: https://build.nvidia.com/
# Required package: openai (install with: pip install openai)
# Model used: nvidia/nemotron-3-nano-30b-a3b
NVIDIA_API_KEY=your-nvidia-api-key-here

# -----------------------------------------------------------------------------
# Groq Cloud Inference
# -----------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
# Required package: groq (install with: pip install groq)
# Chat models: llama-3.3-70b-versatile, qwen/qwen3-32b, groq/compound, etc.
# Transcription models: whisper-large-v3, whisper-large-v3-turbo
# TTS models: canopylabs/orpheus-v1-english
GROQ_API_KEY=your-groq-api-key-here

# =============================================================================
# Quick Start Guide
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Choose your AI provider and set AI_PROVIDER (e.g., AI_PROVIDER=gemini)
# 3. Add your API key for the chosen provider
# 4. Install required packages if needed (see above)
# 5. Run: python manage.py migrate
# 6. Run: python manage.py runserver
# 7. Visit: http://127.0.0.1:8000/
#
# For more details, see CONTRIBUTING.md and README.md
